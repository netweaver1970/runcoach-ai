{
  "name": "runcoach-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create runcoach",
    "db:migrate": "wrangler d1 migrations apply runcoach --remote",
    "db:migrate:local": "wrangler d1 migrations apply runcoach --local",
    "secret:jwt": "wrangler secret put JWT_SECRET",
    "secret:pepper": "wrangler secret put PW_PEPPER",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
