{
  "expo": {
    "name": "RunCoach AI",
    "slug": "running-coach-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.netweaver1970.runcoachai",
      "appleTeamId": "DF5WZ9PTMP",
      "infoPlist": {
        "NSHealthShareUsageDescription": "RunCoach AI reads your running workouts, heart rate, VO2 max, HRV, and sleep data to provide personalised coaching advice.",
        "NSHealthUpdateUsageDescription": "RunCoach AI does not write to Apple Health.",
        "NSLocationWhenInUseUsageDescription": "RunCoach AI uses your location to fetch the current weather so it can factor temperature and conditions into today's training recommendation.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true,
        "com.apple.security.application-groups": [
          "group.com.netweaver1970.runcoachai"
        ]
      }
    },
    "plugins": [
      "@bacons/apple-targets",
      "./plugins/withDisableLldb",
      "./plugins/withHealthKitCapability",
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B35"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "RunCoach AI reads your running workouts, heart rate, VO2 max, HRV, and sleep data to provide personalised coaching advice.",
          "NSHealthUpdateUsageDescription": "RunCoach AI does not write to Apple Health."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "runcoach",
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.netweaver1970.runcoachai.watch",
                  "targetName": "RunCoach",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.netweaver1970.runcoachai"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "221dae0d-a625-41a1-aec7-2e16ca6f6d1b"
      },
      "router": {
        "origin": false
      }
    }
  }
}
