       return hkActivities.map { activity in
+        // Encode the activityType into the uuid field (suffix after "::") so JS
+        // can recover the real HealthKit activity type without a schema change.
+        let actTypeRaw = activity.workoutConfiguration.activityType.rawValue
+
+        // ── Phase label ──────────────────────────────────────────────────────
+        // Try three sources in priority order:
+        //   1. activity.title (iOS 17+) — "Warmup", "Work", "Recovery", "Cooldown"
+        //   2. metadata["HKMetadataKeyWorkoutStepType"] numeric value (0-3)
+        //   3. All metadata keys dumped for debugging
+        var suffix = ""
+        var metaParts: [String] = []
+
+        // Read HKWorkoutActivity metadata.
+        // Key WOIntervalStepKeyPath encodes position in workout plan (e.g. "0.0.0", "1.0.0").
+        // JS uses this + distance heuristic to assign Warmup/Work/Cooldown labels.
+        if let meta = activity.metadata {
+          for (key, value) in meta {
+            let shortKey = key.replacingOccurrences(of: "HKMetadataKey", with: "")
+            let valStr: String
+            if let n = value as? NSNumber { valStr = n.stringValue }
+            else if let s = value as? String { valStr = s }
+            else { continue }   // skip non-scalar values
+            let safe = valStr
+              .replacingOccurrences(of: "|", with: "~")
+              .replacingOccurrences(of: "::", with: "..")
+            metaParts.append("\(shortKey)=\(safe)")
+          }
+        }
+
+        if !metaParts.isEmpty {
+          suffix += "::meta::" + metaParts.joined(separator: "|")
+        }
+
+        // ── Per-segment KPIs from allStatistics ──────────────────────────────
+        // Encodes distance (m), avg HR (bpm), avg power (W) directly from HK.
+        var statParts: [String] = []
+
+        if let distType = HKObjectType.quantityType(forIdentifier: .distanceWalkingRunning),
+           let distStat = activity.allStatistics[distType],
+           let distQ    = distStat.sumQuantity() {
+          let distM = distQ.doubleValue(for: HKUnit.meter())
+          statParts.append("dist=\(Int(distM.rounded()))")
+        }
+
+        if let hrType   = HKObjectType.quantityType(forIdentifier: .heartRate),
+           let hrStat   = activity.allStatistics[hrType],
+           let hrQ      = hrStat.averageQuantity() {
+          let hr = hrQ.doubleValue(for: HKUnit.count().unitDivided(by: .minute()))
+          statParts.append("hr=\(Int(hr.rounded()))")
+        }
+
+        if let powerType  = HKObjectType.quantityType(forIdentifier: .runningPower),
+           let powerStat  = activity.allStatistics[powerType],
+           let powerQ     = powerStat.averageQuantity() {
+          let watts = powerQ.doubleValue(for: HKUnit.watt())
+          statParts.append("power=\(Int(watts.rounded()))")
+        }
+
+        // Step count (used to derive cadence as fallback)
+        if let stepType = HKObjectType.quantityType(forIdentifier: .stepCount),
+           let stepStat = activity.allStatistics[stepType],
+           let stepQ   = stepStat.sumQuantity() {
+          let steps = stepQ.doubleValue(for: HKUnit.count())
+          statParts.append("steps=\(Int(steps.rounded()))")
+        }
+
+        // Running cadence (steps/min) — direct from HK statistics engine.
+        // More accurate than deriving from steps/duration because HK averages
+        // only the actual running samples, excluding any paused periods.
+        let runningCadenceId = HKQuantityTypeIdentifier(rawValue: "HKQuantityTypeIdentifierRunningCadence")
+        if let cadType = HKObjectType.quantityType(forIdentifier: runningCadenceId),
+           let cadStat = activity.allStatistics[cadType],
+           let cadQ   = cadStat.averageQuantity() {
+          let spm = cadQ.doubleValue(for: HKUnit.count().unitDivided(by: .minute()))
+          statParts.append("cad=\(Int(spm.rounded()))")
+        }
+
+        // workoutConfiguration.activityType for the step (may differ from parent workout's 37)
+        let stepActType = activity.workoutConfiguration.activityType.rawValue
+        if stepActType != actTypeRaw {
+          statParts.append("stepAct=\(stepActType)")
+        }
+
+        if !statParts.isEmpty {
+          suffix += "::stat::" + statParts.joined(separator: ";")
+        }
+
+        let uuidWithType = activity.uuid.uuidString + "::" + String(actTypeRaw) + suffix
         return WorkoutActivity(
           startDate: activity.startDate,
           endDate: activity.endDate ?? activity.startDate,
-          uuid: activity.uuid.uuidString,
+          uuid: uuidWithType,
           duration: activity.duration
         )
       }
